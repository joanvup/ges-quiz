# ---------------------------------------------------------------------------
# QuizColegio - variables de entorno de ejemplo
# Copia este archivo a ".env" y ajusta los valores.
# ---------------------------------------------------------------------------

# Base de datos -------------------------------------------------------------
# El motor se deduce automaticamente de esta cadena:
#   SQLite     -> file:./dev.db
#   PostgreSQL -> postgresql://usuario:clave@localhost:5432/quizcolegio?schema=public
#   MySQL      -> mysql://usuario:clave@localhost:3306/quizcolegio
# Al cambiar de motor, detén el servidor y ejecuta "npm run db:preparar" (ajusta
# prisma/schema.prisma y regenera el cliente). Desde el panel de administracion
# (Admin -> Base de datos) tambien puedes migrar los datos y actualizar todo esto.
DATABASE_URL="file:./dev.db"
# Al compilar o arrancar (npm run dev / build), aplica a la base de datos los
# cambios del modelo: solo si las tablas cambiaron, nunca carga datos de prueba
# ni borra informacion. Ponlo en "false" para desactivarlo (por ejemplo en un
# servidor de compilacion que no deba tocar la base de datos).
DATABASE_AUTO_SYNC="true"

# Inicializacion sin datos de prueba ----------------------------------------
# Cuenta de administrador que crea "npm run db:inicializar".
# Si no defines ADMIN_PASSWORD se genera una contrasena aleatoria y se muestra
# una sola vez por consola.
ADMIN_EMAIL="admin@colegio.edu"
ADMIN_PASSWORD=""
ADMIN_NAME="Administrador"

# Servidor ------------------------------------------------------------------
NODE_ENV="development"
# URL publica (usada para cookies y cabeceras)
APP_URL="http://localhost:3000"

# Seguridad -----------------------------------------------------------------
# Secreto para firmar/derivar cosas (genera uno con: openssl rand -base64 32)
APP_SECRET="cambia-esto-por-un-secreto-largo-y-aleatorio-32-chars-min"
# Coste de bcrypt (10 es rapido, 12 mas seguro)
BCRYPT_ROUNDS="10"
# Duracion de la sesion en horas
SESSION_TTL_HOURS="12"

# Subida de archivos --------------------------------------------------------
# Tamano maximo por PDF en megabytes
MAX_UPLOAD_MB="15"
# Directorio donde se guardan los PDFs subidos
UPLOAD_DIR="./storage/uploads"

# Proveedor LLM -------------------------------------------------------------
# Valores posibles: "anthropic" | "openai" | "mock"
# "mock" genera preguntas de prueba sin salir a internet (util para desarrollo).
LLM_PROVIDER="mock"

# Anthropic (https://console.anthropic.com)
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-3-5-sonnet-latest"

# OpenAI (https://platform.openai.com)
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
OPENAI_BASE_URL="https://api.openai.com/v1"

# Parametros de generacion
LLM_MAX_OUTPUT_TOKENS="8000"
LLM_TIMEOUT_MS="120000"

# Extraccion de PDF ---------------------------------------------------------
# Activa OCR (tesseract.js) cuando el PDF no tiene capa de texto.
OCR_ENABLED="false"
OCR_LANGUAGE="spa+eng"
# Limite de paginas a las que se aplica OCR (es lento)
OCR_MAX_PAGES="10"

# Fragmentacion (chunking) --------------------------------------------------
CHUNK_SIZE_CHARS="8000"
CHUNK_OVERLAP_CHARS="800"

# Rate limiting -------------------------------------------------------------
LOGIN_RATE_LIMIT_MAX="10"
LOGIN_RATE_LIMIT_WINDOW_SEC="300"
ANSWER_RATE_LIMIT_MAX="120"
ANSWER_RATE_LIMIT_WINDOW_SEC="60"

# Reportes ------------------------------------------------------------------
# Origen permitido para CORS de la API publica de reportes (opcional)
REPORTS_EXPORT_MAX_ROWS="5000"
